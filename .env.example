# ---- Vapi (rostplattform) ----
VAPI_API_KEY=                 # Private key. Dashboard -> Organization -> API Keys
VAPI_WEBHOOK_SECRET=          # Valfri strang du hittar pa. Sätts ocksa som Server URL Secret i Vapi.
VAPI_PUBLIC_KEY=              # Public key, anvands av webbwidgeten i webblasaren
VAPI_ASSISTANT_ID=            # Fylls i av scripts/setup_vapi.py

# ---- 46elks (SMS, senare aven telefonnummer) ----
ELKS_API_USER=
ELKS_API_PASSWORD=
ELKS_FROM_NUMBER=CFZ          # Fas 1: alfanumerisk avsandare, t.ex. "CFZ". Fas 2: 46elks-numret.

# ---- Notifiering ----
OWNER_PHONE=+46700000000      # Carl-Fredriks mobil, +46-format
OWNER_NAME=Carl-Fredrik Zettermark
NOTIFY_CHANNEL=sms            # sms | email

# ---- E-postfallback (bara om NOTIFY_CHANNEL=email) ----
RESEND_API_KEY=
EMAIL_FROM=assistent@ledarskapskultur.se
OWNER_EMAIL=carl-fredrik@ledarskapskultur.se

# ---- Google Calendar (OAuth for Carl-Fredriks eget konto) ----
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=         # Fas fram med: uv run python scripts/auth_google.py

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Ovrigt ----
TZ=Europe/Stockholm
PUBLIC_BASE_URL=              # t.ex. https://airepa.up.railway.app (satts som serverUrl i Vapi)
